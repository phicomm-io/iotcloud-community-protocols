{
  "id": "daikin-g3-media-v1",
  "version": 1,
  "status": "implemented-unreleased",
  "limits": {
    "jpeg_bytes": 131072,
    "width": 480,
    "height": 854,
    "upload_chunk": 512,
    "queue_including_active": 16,
    "images": 4,
    "title_utf8_bytes": 64,
    "text_utf8_bytes": 512,
    "history": 16,
    "orphan_expiry_ms": 120000,
    "max_fps": 10,
    "notification_views": 4,
    "double_tap_ms": 350,
    "source_url_bytes": 383,
    "source_credential_bytes": 63,
    "first_frame_timeout_ms": 15000,
    "ttl_ms": 86400000
  },
  "defaults": {
    "baud": 115200,
    "baud_mode": "fixed",
    "width": 320,
    "height": 240,
    "fps": 1,
    "duration_ms": 10000,
    "wake": true,
    "brightness": 30,
    "verify_tls": true,
    "ttl_ms": 0,
    "overflow": "reject"
  },
  "rates": [
    115200,
    230400,
    460800,
    921600
  ],
  "actions": {
    "screen.link.get": {
      "required": [],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.link.set": {
      "required": [
        "mode"
      ],
      "optional": [
        "rate",
        "max_rate",
        "apply_now"
      ],
      "access": "ADMIN"
    },
    "screen.media.begin": {
      "required": [
        "id",
        "total",
        "crc32",
        "width",
        "height"
      ],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.media.chunk": {
      "required": [
        "id",
        "offset",
        "bytes"
      ],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.media.commit": {
      "required": [
        "id"
      ],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.media.cancel": {
      "required": [
        "id"
      ],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.media.get": {
      "required": [],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.push.send": {
      "required": [
        "id"
      ],
      "optional": [
        "image_id",
        "title",
        "text",
        "duration_ms",
        "mode",
        "wake",
        "brightness",
        "url",
        "username",
        "password",
        "width",
        "height",
        "fps",
        "verify_tls",
        "ttl_ms",
        "overflow"
      ],
      "access": "CONTROL"
    },
    "screen.push.get": {
      "required": [],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.push.dismiss": {
      "required": [
        "id"
      ],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.stream.get": {
      "required": [],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.stream.set": {
      "required": [
        "url"
      ],
      "optional": [
        "username",
        "password",
        "width",
        "height",
        "fps",
        "enabled",
        "verify_tls"
      ],
      "access": "ADMIN"
    },
    "screen.stream.start": {
      "required": [],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.stream.stop": {
      "required": [],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.push.select": {
      "required": [
        "index"
      ],
      "optional": [],
      "access": "CONTROL"
    },
    "screen.push.update": {
      "required": [
        "id"
      ],
      "optional": [
        "image_id",
        "title",
        "text",
        "duration_ms",
        "mode",
        "wake",
        "brightness",
        "url",
        "username",
        "password",
        "width",
        "height",
        "fps",
        "verify_tls",
        "ttl_ms"
      ],
      "access": "CONTROL",
      "at_least_one_optional": true
    }
  },
  "uart": {
    "version": 1,
    "magic": "GM",
    "delimiter": 0,
    "escape": {
      "00": "dbdc",
      "db": "dbdd"
    },
    "header_bytes": 14,
    "length_endian": "little",
    "session_bytes": 4,
    "sequence_bytes": 4,
    "payload_max": 1152,
    "crc": "CRC32/ISO-HDLC over header and payload, little endian",
    "channels": {
      "link": 0,
      "command": 1,
      "reply": 2,
      "socket": 3,
      "socket_ack": 4,
      "socket_event": 5
    }
  },
  "results": {
    "0": "ok",
    "1": "range",
    "2": "busy",
    "3": "not_found",
    "4": "crc",
    "5": "format",
    "6": "decode",
    "7": "offline"
  },
  "push_states": [
    "empty",
    "queued",
    "displayed",
    "confirmed",
    "timedout",
    "dismissed",
    "failed",
    "expired",
    "dropped",
    "evicted"
  ],
  "scn3": {
    "bytes": 9520,
    "component_type": 8,
    "image_source_offset": 86,
    "image_fit_offset": 87,
    "image_source": 0,
    "image_fit": {
      "0": "contain",
      "1": "cover"
    },
    "pages": 8,
    "components": 32
  },
  "url_push": {
    "capability": 33554432,
    "opcode": 12,
    "same_url": "renew canonical queued id without shortening remaining duration",
    "storage": "transient",
    "image_id": "mutually exclusive with nonzero image_id",
    "source": "HTTP(S) JPEG or MJPEG, detected from response",
    "timer": "starts after first decoded and presented frame",
    "last_push_id": "canonical id in screen.media.get",
    "stream_role": "notification or page"
  },
  "push_update": {
    "capability": 67108864,
    "opcode": 13,
    "header_bytes": 18,
    "mask_bits": [
      "title",
      "text",
      "image_id",
      "mode",
      "duration_ms",
      "wake",
      "brightness",
      "url",
      "username",
      "password",
      "width",
      "height",
      "fps",
      "verify_tls",
      "ttl_ms"
    ],
    "source_bytes": 519,
    "omitted": "preserved",
    "duration_ms": "extend to at least requested visible time",
    "missing_id": "not_found, never replayed",
    "position": "preserved, hidden updates do not select",
    "credentials": "URL change clears omitted credentials",
    "dedup": "send retains original creation fingerprint; UART sequence retries are deduplicated",
    "ttl_bytes": "optional LE32 after mask, before source when bit 14 is present",
    "ttl_ms": "reset hard expiry from receipt; zero disables"
  },
  "push_policy": {
    "capability": 134217728,
    "opcode": 14,
    "header_bytes": 22,
    "ttl_ms": {
      "offset": 16,
      "bytes": 4,
      "zero": "disabled",
      "maximum": 86400000,
      "clock": "monotonic including hidden, queued and suspended time"
    },
    "overflow": {
      "offset": 20,
      "values": {
        "0": "reject",
        "1": "drop_newest",
        "2": "drop_oldest"
      },
      "drop_oldest": "evict oldest waiting notice, preserve active"
    },
    "remote": {
      "offset": 21,
      "values": {
        "0": "uploaded image or text",
        "1": "URL source follows header"
      }
    },
    "status_version": 4,
    "status_queue_item_bytes": 14,
    "status_expires_in_ms_offset": 10,
    "timer_relation": "ttl expiry is independent of visible duration and applies to confirm notices",
    "storage": "transient per-message settings"
  }
}
